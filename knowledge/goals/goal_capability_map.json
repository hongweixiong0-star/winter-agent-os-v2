    "stable_min_rate": 0.8,
    "degraded_min_failures": 2,
    "never_counts_as_verified": [
      "code exists",
      "unit test pass",
      "replay pass",
      "simulation pass",
      "candidate generated",
      "external project supports it",
      "documentation claims it"
    ]
